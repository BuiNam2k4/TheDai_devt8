# Google Gemini API Key (Lấy tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Database (SQL Server)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=hanoiprep_db;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;useUnicode=true;characterEncoding=UTF-8;
DB_USERNAME=sa
DB_PASSWORD=sa

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
